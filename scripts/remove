#!/bin/bash

source /usr/share/yunohost/helpers

#=================================================
# STOP AND REMOVE DOCKER CONTAINER
#=================================================
ynh_script_progression --message="Stopping Docker container..." --weight=2

cd "$install_dir"
docker-compose down -v || true

#=================================================
# REMOVE SYSTEMD SERVICE
#=================================================
ynh_script_progression --message="Removing systemd service..." --weight=1

ynh_remove_systemd_config

#=================================================
# REMOVE NGINX CONFIGURATION
#=================================================
ynh_script_progression --message="Removing NGINX configuration..." --weight=1

ynh_remove_nginx_config

#=================================================
# REMOVE LOG ROTATION
#=================================================
ynh_remove_logrotate

#=================================================
# REMOVE CRON JOB
#=================================================
rm -f "/etc/cron.daily/$app-backup"

#=================================================
# REMOVE APP DIRECTORY
#=================================================
ynh_script_progression --message="Removing app files..." --weight=3

ynh_secure_remove --file="$install_dir"

#=================================================
# REMOVE DATA DIRECTORY
#=================================================
ynh_script_progression --message="Removing data..." --weight=1

ynh_secure_remove --file="$data_dir"

#=================================================
# END OF SCRIPT
#=================================================
ynh_script_progression --message="Removal of $app completed" --last
