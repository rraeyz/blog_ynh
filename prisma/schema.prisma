generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Tek satırlık ayarlar (id = 1). Panel → Ayarlar
model Settings {
  id                Int      @id @default(1)
  passwordHash      String   @default("")
  siteTitle         String   @default("Makale Notları")
  siteDescription   String   @default("Yeni bilimsel makalelerin Türkçe anlatımı")
  siteUrl           String   @default("") // https://blog.rraeyz.me — bülten linkleri ve RSS için
  aiProvider        String   @default("anthropic") // lib/ai.ts PROVIDERS anahtarı
  aiModel           String   @default("")
  aiApiKey          String   @default("")
  aiBaseUrl         String   @default("") // yalnızca "custom" sağlayıcı için
  readMode          String   @default("abstract") // abstract | full (arXiv HTML tam metni)
  maxInputChars     Int      @default(8000) // makale başına modele gönderilecek en fazla karakter
  // Günlük seçim (lib/text.ts pickDaily). Puanlar onda bir: 60 = 6,0/10
  postsPerDay       Int      @default(10) // Günde en fazla kaç yazı (istisna puanlılar aşabilir)
  postsMinPerDay    Int      @default(3) // Eşiği geçen azsa en iyilerle bu sayıya tamamlanır
  scoreThreshold    Int      @default(65) // Ön puanı bu ve üstü olanlar yazılır
  scoreExceptional  Int      @default(85) // Bu ve üstü en fazla sınırını aşar (en çok 15)
  spacePerDay       Int      @default(1) // Bunlardan en az kaçı astronomi/uzay (o gün o kadar uzay haberi varsa)
  spaceNormalPerDay Int      @default(2) // Önemli değilse en fazla kaçı uzay: kaynakların çoğu astronomi, diğer konular gölgede kalmasın
  spaceImportantScore Int    @default(75) // Bu ve üstü uzay haberi normal sınıra takılmaz
  spaceMaxPerDay    Int      @default(4) // Önemlilerle birlikte en fazla kaçı uzay
  fullTextReplace   Int      @default(5) // Tam metni zayıf çıkıp yerine sıradakine bakılacak en fazla haber (günde)
  fullTextPromote   Int      @default(3) // Yer kaldıysa tam metnine bakılacak, eşiğin hemen altındaki en fazla haber (günde)
  dailyHour         Int      @default(9) // günlük işin çalışacağı saat (sunucu saati)
  interests         String   @default("") // doluysa makaleler bu ilgi alanlarına göre seçilir
  monthlyTokenLimit Int      @default(0) // 0 = sınırsız; aşılınca otomatik üretim durur
  autoPublish       Boolean  @default(false) // kapalıyken yazılar taslak olarak bekler
  autoFeature       Boolean  @default(true) // yayımlanan yazının önem puanı featureScore ve üstüyse kendiliğinden öne çıkar
  featureScore      Int      @default(75) // Öne çıkarma eşiği (önem puanı, onda bir; panelde "Öneri" rozeti)
  skyEnabled        Boolean  @default(true) // haftalık gökyüzü takvimi (ana sayfa, /gokyuzu, bülten)
  astroDigest       Boolean  @default(false) // haftanın astronomi özeti bülteni (abonelere e-posta gider)
  astroDigestWeekday Int     @default(0) // 0 = pazar: pazartesi dersinden önce
  autoNewsletter    Boolean  @default(false) // kapalıyken haftalık bülten taslak olarak bekler
  digestWeekday     Int      @default(1) // 0 = pazar, 1 = pazartesi ...
  kunyeUrl          String   @default("") // https://rraeyz.me
  kunyeToken        String   @default("") // Künye → Ayarlar → Güvenlik → API anahtarı
  newsletterTag     String   @default("") // boşsa Künye'deki tüm onaylı abonelere
  imageApiKey       String   @default("") // OpenRouter: kaynağın serbest görseli olmayan yazılara temsili kapak (boşsa üretilmez)
  imageModel        String   @default("black-forest-labs/flux-3-image-klein")
  // Eğitim bölümü: dersler OpenRouter'da (yukarıdaki anahtar) web aramasıyla araştırılarak yazılır
  lessonModel       String   @default("anthropic/claude-sonnet-5.5") // dersi yazan model (okurun gördüğü metin)
  lessonHelperModel String   @default("anthropic/claude-haiku-5.5") // araştırma, plan, denetim, gökyüzü: ucuz model
  lessonWeekdays    String   @default("1,3,5") // Ders yazılan günler (0 = pazar); boşsa ders yazılmaz
  lessonAutoPublish Boolean  @default(true) // denetimden temiz geçen ders kendiliğinden yayımlanır; sorun bulunursa taslak bekler
  updatedAt         DateTime @updatedAt
}

// Düzenli taranan kaynaklar (arXiv kategori linkleri)
model Source {
  id            Int       @id @default(autoincrement())
  url           String    @unique
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String    @default("")
  createdAt     DateTime  @default(now())
}

model Paper {
  id          Int      @id @default(autoincrement())
  externalId  String   @unique // arxiv:2510.12345 ya da url:https://...
  title       String
  authors     String   @default("")
  abstract    String   @default("")
  score       Int      @default(0) // Seçimin ön puanı, onda bir (74 = 7,4/10; başlık ve özetten); 0 = henüz puanlanmadı
  space       Boolean  @default(false) // Puanlayan modele göre astronomi/uzay haberi (günlük uzay sınırları)
  imageUrl    String   @default("") // Beslemedeki görsel; yalnızca serbest lisanslı kurumlarınki gösterilir (lib/topics.ts freeImage)
  topic       String   @default("") // arXiv birincil kategorisi (cs.AI) ya da beslemenin sitesi (lib/topics.ts)
  url         String
  publishedAt DateTime @default(now())
  status      String   @default("new") // new | skipped | written | failed
  error       String   @default("")
  createdAt   DateTime @default(now())
  post        Post?

  @@index([status, createdAt])
}

model Post {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  excerpt      String    @default("") // Kısa gelişme metni: sitenin başında ve bültende görünür
  highlights   String    @default("") // "Kısaca" kutusu: satır başına bir madde
  category     String    @default("") // Konu sekmesi (lib/topics.ts CATEGORIES); yazan model seçer
  importance   Int       @default(0) // Modelin tam metinden önem puanı, onda bir (74 = 7,4/10): bülten seçimi ve öne çıkarma
  image        String    @default("") // Yapay zekâ kapağının dosya adı (lib/images.ts)
  featuredAt   DateTime? // Öne çıkanlarda (en fazla 10; yenisi eklenince en eskisi düşer)
  body         String // Markdown (lib/markdown.ts)
  status       String    @default("draft") // draft | published
  publishedAt  DateTime?
  paperId      Int?      @unique
  paper        Paper?    @relation(fields: [paperId], references: [id], onDelete: SetNull)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
}

// Eğitim bölümü (/egitim): müfredat lib/curriculum.ts'te; seriler, aşamaları (bloklar) ve sıralı dersleri
model Series {
  id        Int      @id @default(autoincrement())
  slug      String   @unique // katalog serilerinde kalıcı katalog anahtarı
  title     String
  summary   String   @default("") // Serinin kapsamı
  track     String   @default("") // Hat: uygulama | astronomi | temel | kavram ("" istekler)
  level     String   @default("") // Eski müfredattan kaldı; kullanılmıyor
  position  Int      @default(0) // Sayfadaki sıra (küçük önce; "Tek dersler" -1)
  planned   Boolean  @default(false) // Eski müfredattan kaldı; kullanılmıyor
  createdAt DateTime @default(now())
  lessons   Lesson[]
  stages    Stage[]
}

// Müfredat bloğu: bir serinin bir aşaması (ya da tek kavram dersi). Hattında sırası gelince derslere bölünür
model Stage {
  id        Int      @id @default(autoincrement())
  key       String   @unique // kalıcı katalog anahtarı: "fotometri/orta", "kavram/nyquist"; derslerdeki [[anahtar]] bağlantıları buna
  seriesId  Int
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  track     String // uygulama | astronomi | temel | kavram
  level     String // temel | orta | ileri | kapsamli
  title     String
  summary   String   @default("") // Önerilen dersler ve kapsam: ders listesi buna göre çıkarılır
  position  Int      @default(0) // Hattaki sıra (küçük önce)
  requires  String   @default("") // Önce bitmesi gereken blokların anahtarları (virgüllü)
  approved  Boolean  @default(true) // Haberlerden önerilen kavram, onaylanana kadar sıraya girmez
  planned   Boolean  @default(false) // Derslere bölündü mü
  createdAt DateTime @default(now())
  lessons   Lesson[]

  @@index([track, position])
}

model Lesson {
  id           Int       @id @default(autoincrement())
  seriesId     Int
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  stageId      Int? // Müfredat bloğu (istenen derslerde yok)
  stage        Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  position     Int       @default(0) // Seri içindeki sıra
  slug         String    @unique
  title        String
  scope        String    @default("") // Bu derste ne anlatılacak (planlamadan ya da elle)
  sourceUrls   String    @default("") // Elle verilen kaynaklar, satır başına bir link: yazarken önce bunlar okunur
  excerpt      String    @default("")
  body         String    @default("") // Markdown + $formül$ + ```kod``` (lib/markdown.ts)
  sources      String    @default("") // Yazarken kullanılan, açıldığı doğrulanmış kaynaklar: "başlık\turl" satırları
  research     String    @default("") // Araştırma aşamasının notları (yazım ve denetim bunlara dayanır; okura gösterilmez)
  review       String    @default("") // Denetim aşamasının bulguları; boşsa temiz
  prerequisites String   @default("") // Önce okunması gereken başka derslerin id'leri (virgüllü)
  level        String    @default("") // temel | orta | ileri | kapsamli (tek derste temelden ileriye); lib/levels.ts
  covers       String    @default("") // Bu derste öğretilenler: serinin sonraki derslerine "okur bunları biliyor" diye verilir
  status       String    @default("planned") // planned | draft | published | failed
  error        String    @default("")
  publishedAt  DateTime?
  reports      LessonReport[]
  writtenAt    DateTime? // Yazıldığı an: hatların dönüşümü buna göre (lib/curriculum.ts nextTracks)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([seriesId, position])
}

// Künye üzerinden abonelere giden bültenler
model Digest {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  subject   String
  body      String
  status    String    @default("draft") // draft | sent | failed
  sentAt    DateTime?
  result    String    @default("")
}

// İç durum: oturum anahtarı, işlerin son çalışma zamanı, aylık token kullanımı
// Gökyüzü takvimi olayları (lib/sky.ts): haftalık araştırma önümüzdeki 5 haftayı yeniler, geçmiş aylar takvimde kalır
model SkyEvent {
  id        Int      @id @default(autoincrement())
  date      String // YYYY-MM-DD, Türkiye takvimi
  time      String   @default("") // SS:DD TSİ ya da boş
  kind      String   @default("diger") // lib/skyKinds.ts
  rank      Int      @default(1) // 3 kaçırılmamalı, 2 öne çıkan, 1 olağan: takvimde belirginlik
  title     String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([date])
}

model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Okurların ders önerileri (/egitim formu). Yalnızca kaydedilir; panelde analiz edilip onaylanınca müfredata girer, ret ya da onayla silinir
model Suggestion {
  id        Int      @id @default(autoincrement())
  title     String
  detail    String   @default("")
  analysis  String   @default("") // yapay zekâ değerlendirmesi, satır satır (lib/text.ts parseSuggestion)
  createdAt DateTime @default(now())
}

// Okurun derste bildirdiği hata ya da anlaşılmayan yer: panelde görünür, "Araştırıp yeniden yaz"da yazara girdi olur, sonra silinir
model LessonReport {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())

  @@index([lessonId])
}
